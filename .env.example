# Access/session protection
ACCESS_CODE=demo-access
SESSION_SECRET=replace-with-a-long-random-value

# Vexa adapter: demo is the default. Use live only when both values exist.
VEXA_MODE=demo
VEXA_BASE_URL=
VEXA_API_KEY=
VEXA_PLATFORM=google_meet

# LLM adapter: demo is the default. The live mode expects an OpenAI-compatible API.
LLM_MODE=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
