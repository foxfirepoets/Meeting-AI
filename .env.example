# Access/session protection
ACCESS_CODE=demo-access
SESSION_SECRET=replace-with-a-long-random-value

# Vexa adapter: demo is the default. Live mode uses separate hosted Vexa keys.
VEXA_MODE=demo
VEXA_BASE_URL=
VEXA_BOT_API_KEY=
VEXA_TRANSCRIPTION_API_KEY=
VEXA_PLATFORM=google_meet

# LLM adapter: demo is the default. Live mode uses the Anthropic Messages API.
LLM_MODE=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
